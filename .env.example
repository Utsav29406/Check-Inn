# PostgreSQL connection string.
#   Local:            postgresql://postgres:password@localhost:5432/checkinn
#   Hosted (Neon, Supabase, RDS…): use the URL they give you, keeping ?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/checkinn

# Random string used to sign login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Google sign-in (optional — the "Continue with Google" button only shows when both are set).
# Create an OAuth client ID (type "Web application") at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: https://<your-domain>/api/auth/google/callback and http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# UPI QR (optional). Guests scan a QR for the exact booking fee, which is paid straight
# into the bank account behind this UPI ID, then enter the UTR. Check payments at /admin/payments.
UPI_ID=
# Payee name shown in the UPI app before paying.
UPI_NAME=CheckInn
# One-time code to create the first admin at /admin/setup (only works while no admin exists).
# Generate with: openssl rand -hex 12
ADMIN_SETUP_CODE=

# Booking confirmation emails (optional), sent from a Gmail account. Turn on 2-Step Verification for that account,
# then create an App password at https://myaccount.google.com/apppasswords (16 letters, no spaces needed).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Site address used in email links.
SITE_URL=https://getcheckinn.vercel.app
# Protects the daily booking-reminder job (/api/cron/reminders). Vercel sends it automatically. Any long random string.
CRON_SECRET=
